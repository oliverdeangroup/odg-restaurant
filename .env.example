# ODG-RESTAURANT configuration. Copy to .env and fill in. Never commit .env.

# Turn off on the server!
DEBUG=False
# Long random text. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Your domain(s), comma separated
ALLOWED_HOSTS=restaurant.oliverdeangroup.com
SITE_URL=https://restaurant.oliverdeangroup.com

# Database: "sqlite" for testing on your PC, "mysql" on the server
DB_ENGINE=mysql
DB_NAME=restaurant_app
DB_USER=restaurant_master
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Uploads, bills and backups live here, OUTSIDE the code folder, so updates never touch them
DATA_DIR=/home/restaurant/odg-data

TIME_ZONE=America/Curacao
GUNICORN_PID_FILE=/home/restaurant/odg-restaurant/run/gunicorn.pid
